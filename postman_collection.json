    {
      "name": "03. Transactions",
      "item": [
        {
          "name": "Add Expense Transaction (Groceries)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Groceries\",\n  \"amount\": -50,\n  \"type\": \"expense\",\n  \"category\": \"Food & Dining\",\n  \"date\": \"2025-05-27\",\n  \"notes\": \"Weekly supermarket groceries\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('transaction_id', jsonData.data._id);",
                  "    console.log('Transaction ID saved:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Income Transaction (Salary)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Salary\",\n  \"amount\": 3500,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"date\": \"2025-05-01\",\n  \"notes\": \"Direct company deposit\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "List All Transactions (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions?limit=10&page=1&sortBy=date&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" },
                { "key": "sortBy", "value": "date" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "type", "value": "expense", "disabled": true },
                { "key": "search", "value": "Groceries", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Monthly Summary (Analytics)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/monthly-summary?year=2025&month=5",
              "host": ["{{base_url}}"],
              "path": ["transactions", "monthly-summary"],
              "query": [
                { "key": "year", "value": "2025" },
                { "key": "month", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get Transaction By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
